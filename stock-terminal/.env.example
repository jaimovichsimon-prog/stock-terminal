# Copy this file to .env and fill in your values
# Get your Anthropic API key at: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-this-to-a-random-secret-string

# Email notifications — sent to NOTIFY_EMAIL when a new user registers
# Use a Gmail account + App Password (https://myaccount.google.com/apppasswords)
NOTIFY_EMAIL=jaimovichsimon@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
